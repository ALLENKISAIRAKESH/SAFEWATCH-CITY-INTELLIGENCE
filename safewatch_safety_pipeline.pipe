{
  "name": "SafeWatch EHS Safety & Threat Detection Pipeline",
  "version": "1.0.0",
  "description": "Load-bearing multi-agent pipeline for automated safety hazard classification, OSHA regulatory reporting, and human-in-the-loop dispatch gate.",
  "components": [
    {
      "id": "webhook_in",
      "provider": "webhook",
      "config": {
        "path": "/api/v1/safewatch/events",
        "method": "POST"
      }
    },
    {
      "id": "vision_preprocessor",
      "provider": "data_transform",
      "config": {
        "filter": "person, vehicle, restricted_zone, fire, ppe_missing",
        "threshold": 0.65
      },
      "input": [
        {
          "lane": "data",
          "from": "webhook_in"
        }
      ]
    },
    {
      "id": "llm_ehs_auditor",
      "provider": "llm_openai",
      "config": {
        "model": "gpt-4o-mini",
        "systemPrompt": "You are the SafeWatch EHS Regulatory Compliance Agent. Classify the severity of incoming safety hazards against OSHA 1910 and ISO 45001 standards. Determine if a regulatory citation or urgent dispatch is required.",
        "temperature": 0.1
      },
      "input": [
        {
          "lane": "text",
          "from": "vision_preprocessor"
        }
      ]
    },
    {
      "id": "human_approval_gate",
      "provider": "human_gate",
      "config": {
        "requiredRole": "EHS Lead / SOC Supervisor",
        "timeoutSeconds": 300,
        "autoEscalate": true
      },
      "input": [
        {
          "lane": "decision",
          "from": "llm_ehs_auditor"
        }
      ]
    },
    {
      "id": "dispatch_actuator",
      "provider": "action_dispatch",
      "config": {
        "target": "Tactical Guard Intercept / OSHA Auto-File",
        "notificationChannel": "WebAudio Siren + SpeechSynthesis"
      },
      "input": [
        {
          "lane": "approved_action",
          "from": "human_approval_gate"
        }
      ]
    },
    {
      "id": "response_out",
      "provider": "response",
      "config": {
        "laneName": "audit_record"
      },
      "input": [
        {
          "lane": "audit_record",
          "from": "dispatch_actuator"
        }
      ]
    }
  ]
}
