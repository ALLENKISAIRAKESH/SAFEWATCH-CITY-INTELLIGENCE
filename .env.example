# RocketRide Buildathon Environment Configuration
# RocketRide Engine URI (Local: ws://localhost:5565, Cloud: wss://cloud.rocketride.ai)
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=rr_live_demo_key_placeholder
ROCKETRIDE_TEAM_ID=team_safewatch_enterprise
ROCKETRIDE_PIPELINE_PATH=pipelines/safewatch_safety_pipeline.pipe

# SafeWatch Database & AI Services
MONGODB_URI=mongodb://localhost:27017/safewatch
PORT=5000
VITE_API_URL=http://localhost:5000

# Optional Model Keys (or leave empty for Local Ollama / YOLOv8)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
